# Deep Tree Echo - Autonomous Consciousness Server
# Production-grade Dockerfile for echoself deployment
# Note: Previous Python version archived in pyversion branch

# Build stage
FROM golang:1.25.13-alpine AS builder

# Install build dependencies. build-base is required by the existing
# go-sqlite3 driver used for the append-only cognitive event ledger.
RUN apk add --no-cache git ca-certificates tzdata build-base

# Set working directory
WORKDIR /src

# Copy go mod files first for caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the autonomous server
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build \
	-ldflags='-s -w' \
    -o /echoself \
    ./cmd/autonomous/

# Runtime stage
FROM alpine:3.19

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata

# Create non-root user
RUN adduser -D -g '' echoself
USER echoself

# Set working directory
WORKDIR /app

# Copy binaries from builder
COPY --from=builder /echoself /app/echoself

# Copy schema files
COPY --from=builder /src/core/memory/schema.dql /app/schema.dql

# Non-secret defaults. Provider and database credentials must be injected at runtime.
ENV DGRAPH_ENDPOINT=dgraph-alpha:9080

# Expose ports
# 8080: HTTP API (health, status, metrics)
# 11434: Ollama-compatible API
EXPOSE 8080 11434

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

# Default command
CMD ["/app/echoself"]
